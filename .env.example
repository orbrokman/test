# Sentinel SRE Agent — Local Development Environment Template
# Copy to `.env` for local runs. NEVER commit real secrets to git!
# In staging/production, credentials are injected via Google Cloud Secret Manager.

SENTINEL_ENV=local
ADK_APP_NAME=app

# Google Cloud / Vertex AI Configuration
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# Strategic Model Routing (Gemini Flash vs Gemini Pro)
SENTINEL_FAST_MODEL=gemini-2.5-flash
SENTINEL_REASONING_MODEL=gemini-2.5-pro
SENTINEL_SUMMARIZER_MODEL=gemini-2.5-flash
SENTINEL_JUDGE_MODEL=gemini-2.5-flash

# Persistent Session & Long-Term Memory Backends
# Local defaults use persistent SQLite; production uses vertex_ai / vertex_ai_memory_bank
SESSION_BACKEND=sqlite
SESSION_DB_URL=sqlite+aiosqlite:///./data/sentinel_sessions.db
MEMORY_BACKEND=sqlite
MEMORY_DB_PATH=./data/sentinel_memory.db
RUNBOOK_DB_PATH=./data/sentinel_runbooks.db

# Managed Vertex AI Resources (populated from `terraform output` in cloud deployments)
VERTEX_AGENT_ENGINE_ID=
VERTEX_AI_SEARCH_DATASTORE_ID=

# Context Compaction & Caching
COMPACTION_INTERVAL=6
COMPACTION_OVERLAP_SIZE=2
COMPACTION_TOKEN_THRESHOLD=24000
COMPACTION_EVENT_RETENTION_SIZE=4
CONTEXT_CACHE_MIN_TOKENS=2048
CONTEXT_CACHE_TTL_SECONDS=1800

# Security, Cloud DLP PII Redaction, Model Armor & Secret Manager
ENABLE_CLOUD_DLP=false
DLP_INSPECT_TEMPLATE=
DLP_DEIDENTIFY_TEMPLATE=
ENABLE_MODEL_ARMOR=false
MODEL_ARMOR_PROMPT_TEMPLATE=
MODEL_ARMOR_RESPONSE_TEMPLATE=
FAIL_CLOSED_SECRETS=false
SCALE_CONFIRMATION_THRESHOLD=10

# Observability & Distributed Tracing
OTEL_SERVICE_NAME=sentinel-sre-agent
OTEL_SERVICE_VERSION=1.0.0
ENABLE_CLOUD_TRACE=false
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=NO_CONTENT
LOG_LEVEL=INFO
BQ_ANALYTICS_DATASET_ID=sentinel_sre_analytics

# Local-only placeholder names (in GCP, fetched from Secret Manager automatically)
# SENTINEL_PAGERDUTY_API_KEY=<inject-via-secret-manager>
# SENTINEL_DEPLOY_API_TOKEN=<inject-via-secret-manager>
