terraform {
  required_version = ">= 1.6.0"

  required_providers {
    google = {
      source  = "hashicorp/google"
      version = "~> 6.10"
    }
    google-beta = {
      source  = "hashicorp/google-beta"
      version = "~> 6.10"
    }
  }

  # Uncomment and configure a remote GCS bucket for team/CI state locking:
  # backend "gcs" {
  #   bucket = "your-tf-state-bucket"
  #   prefix = "sentinel-sre-agent/state"
  # }
}

provider "google" {
  project = var.project_id
  region  = var.region
}

provider "google-beta" {
  project = var.project_id
  region  = var.region
}
